        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "Expected: intent=book_ride, reply confirms ride booked (or asks for more info if backend requires it)."
