{
  "info": {
    "_postman_id": "4f5b39a0-9c1e-4f0e-9c8a-chatbot000001",
    "name": "RideChatbot Test Flow",
    "description": "Full ordered test flow for the RideSharing chatbot. Base URL: http://localhost:8000\n\nSetup:\n1. Start backend: cd src/RideSharing.Api && dotnet run\n2. Start chatbot: cd chatbot && uvicorn main:app --port 8000\n3. Run requests in order 0-19.\n\nTip: capture conversation_id from the /health->chat responses and paste into subsequent requests (or use the {{conv}} variable).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "conv",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health returns 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('status healthy', function() {",
              "  pm.response.to.have.jsonBody('status', 'healthy');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Expected: { status: healthy, service: ridership-chatbot, llm: available, session_store: ok, downstream_api: up }\nIf llm is unavailable -> GOOGLE_API_KEY missing. If downstream_api is unreachable -> backend not running."
      },
      "response": []
    },
    {
      "name": "01 - Help / Support",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('intent is support', function() {",
              "  pm.response.to.have.jsonBody('intent', 'support');",
              "});",
              "pm.response.json().conversation_id && pm.collectionVariables.set('conv', pm.response.json().conversation_id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"message\": \"help\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "Expected: intent=support, reply lists capabilities. Returns conversation_id - saved to {{conv}} automatically."
      },
      "response": []
    },
    {
      "name": "02 - Login Correct",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('intent is login', function() {",
              "  pm.response.to.have.jsonBody('intent', 'login');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"login as passenger john@test.com password Password123!\",\n  \"conversation_id\": \"{{conv}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "Expected: intent=login, reply confirms login success. Uses the conversation from step 01."
      },
      "response": []
    },
    {
      "name": "03 - Login Wrong Password (error path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 200 with error reply', function() {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"login as passenger john@test.com password wrongpass\",\n  \"conversation_id\": \"{{conv}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "Expected: intent=login, reply says invalid email or password."
      },
      "response": []
    },
    {
      "name": "04 - Login Again Correct (restore auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('intent is login', function() {",
              "  pm.response.to.have.jsonBody('intent', 'login');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"john@test.com Password123!\",\n  \"conversation_id\": \"{{conv}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "Expected: intent=login, restores auth for later steps."
      },
      "response": []
    },
    {
