      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"I want to book a ride from Times Square to JFK Airport\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "New conversation (no conversation_id). Expected: intent=book_ride, reply asks for confirmation. New conv id saved."
      },
      "response": []
    },
